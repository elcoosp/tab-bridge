{
  "name": "tab-bridge",
  "version": "1.1.0",
  "description": "OpenAI-compatible facade over a stateful browser chat tab (DeepSeek v1). Bridge + Chrome extension + tests.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "bin": { "tab-bridge": "dist/src/index.js" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
