{
  "name": "tab-bridge",
  "version": "1.2.63",
  "description": "OpenAI-compatible facade over a stateful browser chat tab (DeepSeek v1). Bridge + Chrome extension + tests.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tab-bridge": "dist/src/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "e2e": "node e2e/run-e2e.mjs",
    "start": "node dist/src/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
